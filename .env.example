# FastClaw workspace root (optional — dev builds default to <repo>/workspace,
# release/installed builds default to ~/.fastclaw-rs/workspace).
# FASTCLAW_WORKSPACE=/path/to/workspace

# LLM credentials (OpenAI-compatible gateway: DeepSeek/Kimi/MiniMax/Ollama).
LLM_API_KEY=
LLM_API_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat

# Anthropic gateway (Claude / MiniMax / DeepSeek-anthropic).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
